rules_version = '2';
// POC Ops Center — Firestore security rules.
// Replace the owner email below if it changes. Paste this whole file in Firebase console > Firestore > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email != null
                          && request.auth.token.email.lower() == 'masum@expertmobile.ca'; }
    function rolesDoc() { return get(/databases/$(database)/documents/access/roles).data; }
    function listed() { return signedIn() && exists(/databases/$(database)/documents/access/roles)
                          && rolesDoc().users.keys().hasAny([request.auth.uid])
                          && rolesDoc().users[request.auth.uid].get('disabled', false) != true; }
    // Invites: an admin can give access to an email before that person has ever signed in.
    function myEmail()   { return request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    function invited()   { return signedIn() && request.auth.token.email_verified == true && myEmail() != ''
                          && exists(/databases/$(database)/documents/access/roles)
                          && rolesDoc().get('invites', {}).keys().hasAny([myEmail()])
                          && !rolesDoc().users.keys().hasAny([request.auth.uid]); }
    function invRole()   { return rolesDoc().invites[myEmail()].role; }
    function hasAccess() { return isOwner() || listed() || invited(); }
    function isAdmin()   { return isOwner() || (listed() && rolesDoc().users[request.auth.uid].role == 'admin') || (invited() && invRole() == 'admin'); }
    function isManager() { return isAdmin() || (listed() && rolesDoc().users[request.auth.uid].role == 'manager') || (invited() && invRole() == 'manager'); }
    function privateColl(c) { return c in ['inv', 'invfiles', 'invchunks', 'uplog', 'guides', 'guidechunks']; }

    // Everyone who signs in may create their own profile (so admins can find them) and read the access list.
    match /profiles/{uid}  { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == uid; }
    match /access/roles    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /presence/{uid}  { allow read: if hasAccess(); allow write: if signedIn() && request.auth.uid == uid; }
    match /assets/{id}     { allow read: if signedIn(); allow write: if isAdmin(); }
    // Managers (and admins) can record actions and edit fleet maps.
    match /actions/{id}    { allow read: if hasAccess(); allow write: if isManager(); }
    match /fleetmap/{id}   { allow read: if hasAccess(); allow write: if isManager(); }
    // Weekly uploads: managers (and admins) may load Inrico / Jasper / Simplex / Hologram data.
    match /companies/{id}  { allow write: if isManager(); }
    match /sims/{id}       { allow write: if isManager(); }
    match /meta/sources    { allow write: if isManager(); }
    match /history/{id}    { allow write: if isManager(); }
    // Upload footprint, Products & inventory, file library: admins and managers only.
    match /uplog/{id}      { allow read, write: if isManager(); }
    match /inv/{id}        { allow read, write: if isManager(); }
    match /invfiles/{id}   { allow read, write: if isManager(); }
    match /invchunks/{id}  { allow read, write: if isManager(); }
    // Help & guides: admins upload and release PDF guides; everyone with access reads released ones.
    match /guides/{id}      { allow read: if isAdmin() || (hasAccess() && resource.data.released == true); allow write: if isAdmin(); }
    match /guidechunks/{id} { allow read: if isAdmin() || (hasAccess() && get(/databases/$(database)/documents/guides/$(resource.data.g)).data.released == true); allow write: if isAdmin(); }
    // Everything else (companies, sims, settings, history, meta, log, system): read with access, write admins only.
    // The private collections above are excluded here, because any rule that allows access wins.
    match /{coll}/{id}     { allow read: if hasAccess() && !privateColl(coll); allow write: if isAdmin() && !privateColl(coll); }
  }
}
